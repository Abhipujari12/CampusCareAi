rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && (
        request.auth.uid == userId ||
        userId.matches('^u-[0-9]+$')
      );
    }

    // 1. Users Collection rules
    match /users/{userId} {
      allow read, write: if true;

      // Notifications subcollection
      match /notifications/{notificationId} {
        allow read, write: if true;
      }

      // Settings subcollection (e.g. notifications settings)
      match /settings/{settingId} {
        allow read, write: if true;
      }
    }

    // 2. Complaints Collection rules
    match /complaints/{complaintId} {
      allow read, write: if true;

      // Comments subcollection
      match /comments/{commentId} {
        allow read, write: if true;
      }
    }

    // 3. Announcements Collection rules
    match /announcements/{announcementId} {
      allow read, write: if true;
    }

    // 4. Colleges Collection rules
    match /colleges/{collegeId} {
      allow read, write: if true;
    }

    // 5. System probe / status collection
    match /system/{docId} {
      allow read, write: if true;
    }
  }
}

