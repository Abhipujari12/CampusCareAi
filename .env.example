# GEMINI_API_KEY: Google Gemini AI API key for complaint image diagnostics and triage
GEMINI_API_KEY=your_gemini_api_key_here

# APP_URL: Production or local deployment URL
APP_URL=http://localhost:3000

# DATABASE_URL: PostgreSQL database connection string (e.g., Neon or Cloud SQL)
DATABASE_URL=postgresql://user:password@localhost:5432/campuscare

# SECRET_KEY: Secret key for signing stateful JWT tokens
SECRET_KEY=your_super_secret_signing_key_32_characters_long

# JWT_ALGORITHM: Encoding algorithm used (default HS256)
JWT_ALGORITHM=HS256

# ACCESS_TOKEN_EXPIRE_MINUTES: Validity duration of access tokens
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CLOUDINARY_URL: Optional cloud storage integration URL for user attachments
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_cloudinary_unsigned_upload_preset

# SMTP Email Configuration for Dispatch Notifications
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@college.edu
EMAIL_PASSWORD=your_secure_smtp_password
